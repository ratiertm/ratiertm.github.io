#xA;&#xA;        .cta-section {&#xA;            background: linear-gradient(135deg, #E67E22 0%, #D35400 100%);&#xA;            color: white;&#xA;            padding: 48px 32px;&#xA;            border-radius: 16px;&#xA;            text-align: center;&#xA;            margin: 48px 0;&#xA;        }&#xA;&#xA;        .cta-section h3 {&#xA;            color: white;&#xA;            font-size: 1.4rem;&#xA;            margin: 0 0 16px 0;&#xA;        }&#xA;&#xA;        .cta-section p {&#xA;            opacity: 0.95;&#xA;            margin-bottom: 0;&#xA;        }&#xA;&#xA;        .cta-button {&#xA;            display: inline-block;&#xA;            background: white;&#xA;            color: var(--secondary-color);&#xA;            padding: 16px 40px;&#xA;            border-radius: 30px;&#xA;            text-decoration: none;&#xA;            font-weight: 700;&#xA;            margin-top: 24px;&#xA;            transition: transform 0.2s, box-shadow 0.2s;&#xA;        }&#xA;&#xA;        .cta-button:hover {&#xA;            transform: translateY(-2px);&#xA;            box-shadow: 0 8px 25px rgba(0,0,0,0.2);&#xA;        }&#xA;&#xA;        .help-section {&#xA;            background: #F8F9FA;&#xA;            padding: 32px;&#xA;            border-radius: 16px;&#xA;            margin: 40px 0;&#xA;            text-align: center;&#xA;        }&#xA;&#xA;        .help-section p {&#xA;            margin-bottom: 12px;&#xA;        }&#xA;&#xA;        footer {&#xA;            margin-top: 60px;&#xA;            padding-top: 32px;&#xA;            border-top: 1px solid var(--border-color);&#xA;            text-align: center;&#xA;            color: var(--text-light);&#xA;            font-size: 0.9rem;&#xA;        }&#xA;&#xA;        .references {&#xA;            background: #F8F9FA;&#xA;            padding: 24px;&#xA;            border-radius: 12px;&#xA;            margin-top: 40px;&#xA;            font-size: 0.9rem;&#xA;        }&#xA;&#xA;        .references h4 {&#xA;            margin-bottom: 12px;&#xA; 