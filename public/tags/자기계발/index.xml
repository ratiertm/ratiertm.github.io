E74C3C;&#xA;            --text-color: #333;&#xA;            --text-light: #666;&#xA;            --bg-color: #FAFAFA;&#xA;            --card-bg: #FFFFFF;&#xA;            --border-color: #E0E0E0;&#xA;        }&#xA;&#xA;        * {&#xA;            margin: 0;&#xA;            padding: 0;&#xA;            box-sizing: border-box;&#xA;        }&#xA;&#xA;        body {&#xA;            font-family: &#39;Noto Sans KR&#39;, -apple-system, BlinkMacSystemFont, sans-serif;&#xA;            line-height: 1.9;&#xA;            color: var(--text-color);&#xA;            background-color: var(--bg-color);&#xA;        }&#xA;&#xA;        article {&#xA;            max-width: 100%;&#xA;            margin: 0;&#xA;            padding: 60px 48px;&#xA;            background-color: var(--card-bg);&#xA;            min-height: 100vh;&#xA;        }&#xA;&#xA;        /* Header */&#xA;        header {&#xA;            margin-bottom: 48px;&#xA;            padding-bottom: 32px;&#xA;            border-bottom: 1px solid var(--border-color);&#xA;        }&#xA;&#xA;        h1 {&#xA;            font-size: 1.875rem;&#xA;            font-weight: 700;&#xA;            color: var(--primary-color);&#xA;            line-height: 1.4;&#xA;            margin-bottom: 16px;&#xA;            word-break: keep-all;&#xA;        }&#xA;&#xA;        .meta {&#xA;            font-size: 0.9rem;&#xA;            color: var(--text-light);&#xA;        }&#xA;&#xA;        /* Headings */&#xA;        h2 {&#xA;            font-size: 1.5rem;&#xA;            font-weight: 700;&#xA;            color: var(--primary-color);&#xA;            margin-top: 56px;&#xA;            margin-bottom: 24px;&#xA;            padding-bottom: 12px;&#xA;            border-bottom: 2px solid var(--secondary-color);&#xA;        }&#xA;&#xA;        h3 {&#xA;            font-size: 1.25rem;&#xA;            font-weight: 700;&#xA;            color: var(--primary-color);&#xA;            margin-top: 40px;&#xA;            margin-bottom: 16px;&#xA;        }&#xA;&#xA;        /* Paragraphs */&#xA;        p {&#xA;            margin-bottom: 20px;&#xA;            font-size: 1.0625rem;&#xA;            word-break: keep-all;&#xA;        }&#xA;&#xA;        strong {&#xA;            color: var(--primary-color);&#xA;            font-weight: 700;&#xA;        }&#xA;&#xA;        /* Lists */&#xA;        ul, ol {&#xA;            margin: 20px 0;&#xA;            padding-left: 24px;&#xA;        }&#xA;&#xA;        li {&#xA;            margin-bottom: 12px;&#xA;            font-size: 1.0625rem;&#xA;        }&#xA;&#xA;        /* Highlight Box */&#xA;        .highlight-box {&#xA;            background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);&#xA;            border-left: 4px solid var(--secondary-color);&#xA;            padding: 24px;&#xA;            margin: 32px 0;&#xA;            border-radius: 0 12px 12px 0;&#xA;        }&#xA;&#xA;        .highlight-box p {&#xA;            margin-bottom: 0;&#xA;            font-size: 1.125rem;&#xA;            font-weight: 500;&#xA;        }&#xA;&#xA;        /* Tip Box */&#xA;        .tip-box {&#xA;            background: #E8F4FD;&#xA;            border-left: 4px solid var(--secondary-color);&#xA;            padding: 24px;&#xA;            margin: 32px 0;&#xA;            border-radius: 0 8px 8px 0;&#xA;        }&#xA;&#xA;        .tip-box h4 {&#xA;            color: var(--secondary-color);&#xA;            font-size: 1rem;&#xA;            margin-bottom: 12px;&#xA;        }&#xA;&#xA;        /* Statistics Box */&#xA;        .stat-box {&#xA;            background: var(--primary-color);&#xA;            color: white;&#xA;            padding: 32px;&#xA;            margin: 32px 0;&#xA;            border-radius: 12px;&#xA;            text-align: center;&#xA;        }&#xA;&#xA;        .stat-number {&#xA;            font-size: 3rem;&#xA;            font-weight: 700;&#xA;            display: block;&#xA;            margin-bottom: 8px;&#xA;        }&#xA;&#xA;        .stat-label {&#xA;            font-size: 1rem;&#xA;            opacity: 0.9;&#xA;        }&#xA;&#xA;        /* Action Steps */&#xA;        .action-steps {&#xA;            background: #FFF9E6;&#xA;            border: 1px solid #FFE082;&#xA;            padding: 28px;&#xA;            margin: 32px 0;&#xA;            border-radius: 12px;&#xA;        }&#xA;&#xA;        .action-steps h4 {&#xA;            color: #F57C00;&#xA;            font-size: 1.125rem;&#xA;            margin-bottom: 16px;&#xA;        }&#xA;&#xA;        .action-steps ol {&#xA;            padding-left: 20px;&#xA;        }&#xA;&#xA;        .action-steps li {&#xA;            margin-bottom: 8px;&#xA;        }&#xA;&#xA;        /* Summary Box */&#xA;        .summary-box {&#xA;            background: #F5F5F5;&#xA;            padding: 28px;&#xA;            margin: 32px 0;&#xA;            border-radius: 12px;&#xA;        }&#xA;&#xA;        .summary-box ul {&#xA;            list-style: none;&#xA;            padding: 0;&#xA;        }&#xA;&#xA;        .summary-box li {&#xA;            padding-left: 28px;&#xA;            position: relative;&#xA;            margin-bottom: 16px;&#xA;        }&#xA;&#xA;        .summary-box li::before {&#xA;            content: &#34;✓&#34;;&#xA;            position: absolute;&#xA;            left: 0;&#xA;            color: var(--secondary-color);&#xA;            font-weight: 700;&#xA;        }&#xA;&#xA;        /* CTA Section */&#xA;        .cta-section {&#xA;            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);&#xA;            color: white;&#xA;            padding: 48px 32px;&#xA;            border-radius: 16px;&#xA;            text-align: center;&#xA;            margin: 56px 0 40px;&#xA;        }&#xA;&#xA;        .cta-section h3 {&#xA;            color: white;&#xA;            font-size: 1.5rem;&#xA;            margin-top: 0;&#xA;            margin-bottom: 12px;&#xA;        }&#xA;&#xA;        .cta-section p {&#xA;            opacity: 0.95;&#xA;            margin-bottom: 24px;&#xA;        }&#xA;&#xA;        .cta-button {&#xA;            display: inline-block;&#xA;            background: white;&#xA;            color: #667eea;&#xA;            padding: 16px 48px;&#xA;            border-radius: 50px;&#xA;            text-decoration: none;&#xA;            font-weight: 700;&#xA;            font-size: 1.0625rem;&#xA;            transition: transform 0.2s, box-shadow 0.2s;&#xA;        }&#xA;&#xA;        .cta-button:hover {&#xA;            transform: translateY(-2px);&#xA;            box-shadow: 0 8px 25px rgba(0,0,0,0.2);&#xA;        }&#xA;&#xA;        /* Divider */&#xA;        hr {&#xA;            border: none;&#xA;            border-top: 1px solid var(--border-color);&#xA;            margin: 48px 0;&#xA;        }&#xA;&#xA;        /* Footer */&#xA;        footer {&#xA;            margin-top: 56px;&#xA;            padding-top: 32px;&#xA;            border-top: 1px solid var(--border-color);&#xA;            text-align: center;&#xA;        }&#xA;&#xA;        footer p {&#xA;            color: var(--text-light);&#xA;            font-size: 0.9375rem;&#xA;        }&#xA;&#xA;        .references {&#xA;            margin-top: 40px;&#xA;            padding: 24px;&#xA;            background: #F9F9F9;&#xA;            border-radius: 8px;&#xA;        }&#xA;&#xA;        .references h4 {&#xA;            font-size: 1rem;&#xA;            color: var(--text-light);&#xA;            margin-bottom: 12px;&#xA;        }&#xA;&#xA;        .references ul {&#xA;            list-style: none;&#xA;            padding: 0;&#xA;        }&#xA;&#xA;        .references li {&#xA;            font-size: 0.875rem;&#xA;            color: var(--text-light);&#xA;            margin-bottom: 4px;&#xA;        }&#xA;&#xA;        /* Blockquote */&#xA;        blockquote {&#xA;            border-left: 4px solid var(--secondary-color);&#xA;            padding-left: 20px;&#xA;            margin: 24px 0;&#xA;            font-style: italic;&#xA;            color: var(--text-light);&#xA;        }&#xA;&#xA;        /* Responsive */&#xA;        @media (max-width: 600px) {&#xA;            article {&#xA;                padding: 40px 20px;&#xA;            }&#xA;&#xA;            h1 {&#xA;                font-size: 1.5rem;&#xA;            }&#xA;&#xA;            h2 {&#xA;                font-size: 1.25rem;&#xA;                margin-top: 40px;&#xA;            }&#xA;&#xA;            h3 {&#xA;                font-size: 1.125rem;&#xA;            }&#xA;&#xA;            p, li {&#xA;                font-size: 1rem;&#xA;            }&#xA;&#xA;            .stat-number {&#xA;                font-size: 2.5rem;&#xA;            }&#xA;&#xA;            .cta-section {&#xA;                padding: 36px 24px;&#xA;            }&#xA;&#xA;            .cta-button {&#xA;                padding: 14px 36px;&#xA;            }&#xA;        }&#xA;    &lt;/style&gt;&#xA;&lt;/head&gt;&#xA;&lt;body&gt;&#xA;    &lt;article&gt;&#xA;        &lt;header&gt;&#xA;            &lt;h1&gt;결정 하나에 일주일씩 고민하는 당신에게&lt;br&gt;- 심리학 연구로 알아보는 &#39;분석마비&#39; 탈출법&lt;/h1&gt;&#xA;            &lt;p class=&#34;meta&#34;&gt;2026년 1월 21일 · 마인드빌드&lt;/p&gt;</description>
      
